# Remnawave API
REMNAWAVE_API_BASE_URL=https://remnawave.example.invalid
REMNAWAVE_API_TOKEN=replace-with-remnawave-api-token
REMNAWAVE_BLOCK_SQUAD=replace-with-blocking-squad

# MaxMind GeoLite2 City
MAXMIND_ACCOUNT_ID=replace-with-maxmind-account-id
